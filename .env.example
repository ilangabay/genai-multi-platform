# Copy to .env and run with: uv run --env-file .env uvicorn app.main:app --port 8000
# All values below are the defaults.

# Storage: "memory" (local runs: nothing persisted, demo data at every start)
# or "postgres" (deployments: state kept in PostgreSQL, no demo data, needs DATABASE_URL)
STORAGE=memory
# Required when STORAGE=postgres. Contains the password: keep this file out of git (.env is gitignored).
DATABASE_URL=postgresql://gateway:change-me@db.internal:5432/gateway

# docker compose only: password of the PostgreSQL container (compose builds DATABASE_URL from it).
# Letters and digits only, since it goes into a URL.
POSTGRES_PASSWORD=

# First passwords of the startup accounts: "admin" (admin) and the GATEWAY_USERS demo users (user role).
# With STORAGE=postgres the first start refuses a default or short ADMIN_PASSWORD (12+ characters needed).
ADMIN_PASSWORD=admin
USER_PASSWORD=user
GATEWAY_USERS=alice,bob,carol

# Sign-ins expire after this many hours
SESSION_HOURS=12
# 1 = the session cookie is only sent over HTTPS: set it when the app is behind your TLS proxy
COOKIE_SECURE=0

# Endpoint shown to users: the guardrail LiteLLM endpoint. Empty = this server's mock (<server>/v1)
LITELLM_BASE_URL=

# Budget in USD for new projects and project requests
DEFAULT_PROJECT_BUDGET=100

# Bedrock region for in-region models and their prices
BEDROCK_REGION=eu-west-3
# AWS Price List Bulk API (public, no credentials). Its host must be on the proxy allowlist.
PRICING_URL=https://pricing.us-east-1.amazonaws.com
# 1 = load Bedrock prices from PRICING_URL at startup (falls back to built-in prices on error)
SYNC_PRICES=0

# On-prem LiteLLM upstream (OpenAI-compatible, e.g. vLLM)
ONPREM_API_BASE=http://onprem-llm.internal:8000/v1
